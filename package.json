{
  "name": "tunnelnote",
  "productName": "TunnelNote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first SSH workspace.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:linux": "electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "start:linux": "electron-vite build && electron-vite preview -- --ozone-platform=x11",
    "preview": "electron-vite preview",
    "preview:linux": "electron-vite preview -- --ozone-platform=x11",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.34.0",
    "ssh2": "1.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "author": "TunnelNote contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iven86/tunnelnote.git"
  }
}
